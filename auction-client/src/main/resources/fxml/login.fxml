<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.LoginController"
      alignment="CENTER" spacing="20" stylesheets="@../css/style.css"
      prefWidth="420" prefHeight="480">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox alignment="CENTER" spacing="6">
        <Label text="HỆ THỐNG ĐẤU GIÁ" styleClass="title-text"/>
        <Label text="Online Auction System" styleClass="subtitle-text"/>
    </VBox>

    <VBox spacing="14" styleClass="card-pane">
        <VBox spacing="6">
            <Label text="Tên đăng nhập:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtUsername" promptText="ví dụ: bidder1 hoặc seller1" text="bidder1"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Mật khẩu:" style="-fx-font-weight: bold;"/>
            <PasswordField fx:id="txtPassword" text="123456"/>
        </VBox>

        <Button text="Đăng nhập" onAction="#handleLogin" maxWidth="Infinity" styleClass="btn-primary"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Chưa có tài khoản?" styleClass="subtitle-text"/>
            <Hyperlink text="Đăng ký ngay" onAction="#handleOpenRegister" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </HBox>
    </VBox>

    <Label fx:id="lblStatus" text="Đang kết nối Server..." styleClass="subtitle-text"/>
</VBox>
